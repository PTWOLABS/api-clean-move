generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  ESTABLISHMENT
  EMPLOYEE
  ADMIN
}

enum OAuthProvider {
  GOOGLE
}

enum AppointmentStatus {
  SCHEDULED
  DONE
  CANCELLED
}

enum QuotePaymentMethod {
  CASH
  PIX
  CARD
  OTHER
}

enum QuoteDiscountType {
  PERCENTAGE
  AMOUNT
}

enum ServicePriceType {
  FIXED
  STARTING_AT
  RANGE
}

model Employee {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  userId          String    @unique @map("user_id") @db.Uuid
  name            String?
  cpf             String?   @db.VarChar(11)
  birthDate       DateTime? @map("birth_date")
  features        String[]  @default(["read:appointments", "read:services", "read:customers", "read:employees:self", "create:sessions:self", "read:sessions:self"])
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([establishmentId])
  @@index([establishmentId, deletedAt])
  @@map("employees")
}

model User {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  email           String   @unique
  hashedPassword  String?  @map("hashed_password")
  role            UserRole
  profileImageUrl String?  @map("profile_image_url")
  phone           String?  @db.VarChar(11)
  address         Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at")

  socialAccounts     SocialAccount[]
  sessions           Session[]
  passwordResetToken              PasswordResetToken?
  passwordChangeConfirmationCode  PasswordChangeConfirmationCode?
  ownedEstablishment              Establishment?                  @relation("EstablishmentOwner")
  employee           Employee?

  @@index([role])
  @@map("users")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at")
  revokedAt        DateTime? @map("revoked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("sessions")
}

model SocialAccount {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  provider  OAuthProvider
  subjectId String        @map("subject_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subjectId])
  @@index([userId])
  @@map("social_accounts")
}

model PasswordResetToken {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @map("user_id") @db.Uuid
  hashedToken String   @map("hashed_token")
  expiresAt   DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([hashedToken])
  @@map("password_reset_tokens")
}

model PasswordChangeConfirmationCode {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  hashedCode          String   @map("hashed_code")
  pendingPasswordHash String   @map("pending_password_hash")
  failedAttempts      Int      @default(0) @map("failed_attempts")
  expiresAt           DateTime @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@map("password_change_confirmation_codes")
}

model Customer {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  cpfCnpj         String?   @map("cpf_cnpj") @db.VarChar(14)
  fullName        String    @map("full_name")
  phone           String?   @db.VarChar(11)
  email           String?
  address         Json?
  birthDate       DateTime? @map("birth_date")
  nickname        String?
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  establishment Establishment     @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  vehicles      CustomerVehicle[]
  appointments  Appointment[]
  quotes        Quote[]

  @@index([establishmentId])
  @@index([establishmentId, fullName])
  @@index([establishmentId, phone])
  @@index([establishmentId, email])
  @@index([establishmentId, deletedAt])
  @@map("customers")
}

model CustomerVehicle {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  imageUrl        String?   @map("image_url")
  plate           String?   @db.VarChar(12)
  brand           String
  model           String
  color           String?
  year            Int?
  notes           String?   @db.Text
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  appointments  Appointment[]
  quotes        Quote[]

  @@index([establishmentId])
  @@index([customerId])
  @@index([establishmentId, plate])
  @@index([establishmentId, deletedAt])
  @@map("customer_vehicles")
}

model Establishment {
  id                    String    @id @default(uuid()) @db.Uuid
  ownerId               String    @unique @map("owner_id") @db.Uuid
  bannerImageUrl        String?   @map("banner_image_url")
  tradeName             String?
  legalBusinessName     String?
  slug                  String?   @unique
  cnpj                  String?   @unique @db.VarChar(14)
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  owner             User              @relation("EstablishmentOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  services          Service[]
  serviceCategories ServiceCategory[]
  customers         Customer[]
  vehicles          CustomerVehicle[]
  appointments      Appointment[]     @relation("EstablishmentAppointments")
  employees         Employee[]
  quotes            Quote[]

  @@index([tradeName])
  @@map("establishments")
}

model ServiceCategory {
  id              String    @id @default(uuid()) @db.Uuid
  establishmentId String    @map("establishment_id") @db.Uuid
  name            String    @db.VarChar(48)
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  services      Service[]

  @@index([establishmentId, name])
  @@index([establishmentId, deletedAt])
  @@map("service_categories")
}

model Service {
  id                            String           @id @default(uuid()) @db.Uuid
  establishmentId               String           @map("establishment_id") @db.Uuid
  serviceName                   String           @map("service_name") @db.VarChar(72)
  description                   String?          @db.Text
  categoryId                    String?          @map("category_id") @db.Uuid
  estimatedDurationMinInMinutes Int?             @map("estimated_duration_min_in_minutes")
  estimatedDurationMaxInMinutes Int?             @map("estimated_duration_max_in_minutes")
  priceInCents                  Int              @map("price_in_cents")
  priceSpecificationType        ServicePriceType @default(FIXED) @map("price_specification_type")
  priceRangeMaxInCents          Int?             @map("price_range_max_in_cents")
  isActive                      Boolean          @default(true) @map("is_active")
  createdAt                     DateTime         @default(now()) @map("created_at")
  updatedAt                     DateTime         @default(now()) @updatedAt @map("updated_at")
  deletedAt                     DateTime?        @map("deleted_at")

  establishment       Establishment              @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  category            ServiceCategory?           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  appointmentBookings AppointmentBookedService[]
  quoteServices       QuoteService[]

  @@index([establishmentId])
  @@index([establishmentId, deletedAt])
  @@index([establishmentId, serviceName])
  @@index([establishmentId, categoryId])
  @@index([establishmentId, priceInCents])
  @@map("services")
}

model Appointment {
  id               String            @id @default(uuid()) @db.Uuid
  establishmentId  String            @map("establishment_id") @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  customerFullName String            @map("customer_full_name")
  vehicleId        String?           @map("vehicle_id") @db.Uuid
  vehiclePlate     String?           @map("vehicle_plate") @db.VarChar(12)
  vehicleBrand     String?           @map("vehicle_brand")
  vehicleModel     String?           @map("vehicle_model")
  vehicleColor     String?           @map("vehicle_color")
  vehicleYear      Int?              @map("vehicle_year")
  startsAt         DateTime          @map("starts_at")
  endsAt           DateTime?         @map("ends_at")
  description      String?           @db.Text
  discountInCents  Int?              @map("discount_in_cents")
  status           AppointmentStatus @default(SCHEDULED)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at")
  doneAt           DateTime?         @map("done_at")
  cancelledAt      DateTime?         @map("cancelled_at")
  deletedAt        DateTime?         @map("deleted_at")

  establishment      Establishment              @relation("EstablishmentAppointments", fields: [establishmentId], references: [id], onDelete: Restrict)
  customer           Customer                   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle            CustomerVehicle?           @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  bookedServices     AppointmentBookedService[]
  convertedFromQuote Quote?

  @@index([establishmentId])
  @@index([customerId])
  @@index([vehicleId])
  @@index([establishmentId, startsAt])
  @@index([establishmentId, status])
  @@index([establishmentId, customerId])
  @@index([establishmentId, vehicleId])
  @@index([establishmentId, deletedAt])
  @@map("appointments")
}

model AppointmentBookedService {
  id                            String           @id @default(uuid()) @db.Uuid
  appointmentId                 String           @map("appointment_id") @db.Uuid
  serviceId                     String           @map("service_id") @db.Uuid
  serviceName                   String           @map("service_name") @db.VarChar(72)
  serviceCategoryId             String?          @map("service_category_id") @db.Uuid
  serviceCategoryName           String?          @map("service_category_name") @db.VarChar(48)
  serviceDurationInMinutes      Int?             @map("service_duration_in_minutes")
  servicePriceInCents           Int              @map("service_price_in_cents")
  servicePriceDefaultInCents    Int              @map("service_price_default_in_cents")
  servicePriceSpecificationType ServicePriceType @default(FIXED) @map("service_price_specification_type")
  servicePriceRangeMaxInCents   Int?             @map("service_price_range_max_in_cents")
  serviceIsActive               Boolean          @default(true) @map("service_is_active")
  position                      Int              @default(0)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service     Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([appointmentId, serviceId])
  @@index([appointmentId])
  @@index([serviceId])
  @@index([serviceId, serviceName])
  @@map("appointment_booked_services")
}

model Quote {
  id                             String    @id @default(uuid()) @db.Uuid
  establishmentId                String    @map("establishment_id") @db.Uuid
  customerId                     String?   @map("customer_id") @db.Uuid
  vehicleId                      String?   @map("vehicle_id") @db.Uuid
  convertedAppointmentId         String?   @unique @map("converted_appointment_id") @db.Uuid
  convertedAt                    DateTime? @map("converted_at")
  establishmentName              String    @map("establishment_name")
  establishmentLegalBusinessName String    @map("establishment_legal_business_name")
  establishmentCnpj              String    @map("establishment_cnpj") @db.VarChar(14)
  establishmentAddress           Json?     @map("establishment_address")
  establishmentBannerImageUrl    String?   @map("establishment_banner_image_url")
  customerName                   String    @map("customer_name")
  customerPhone                  String?   @map("customer_phone") @db.VarChar(11)
  customerCpfCnpj                String?   @map("customer_cpf_cnpj") @db.VarChar(14)
  customerAddress                Json?     @map("customer_address")
  vehiclePlate                   String?   @map("vehicle_plate") @db.VarChar(12)
  vehicleBrand                   String?   @map("vehicle_brand")
  vehicleModel                   String?   @map("vehicle_model")
  vehicleColor                   String?   @map("vehicle_color")
  vehicleYear                    Int?      @map("vehicle_year")
  description                    String?   @db.Text
  termsAndConditions             String?   @map("terms_and_conditions") @db.Text
  expiresAt                      DateTime? @map("expires_at")
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @default(now()) @updatedAt @map("updated_at")

  establishment        Establishment        @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  customer             Customer?            @relation(fields: [customerId], references: [id], onDelete: Restrict)
  vehicle              CustomerVehicle?     @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  convertedAppointment Appointment?         @relation(fields: [convertedAppointmentId], references: [id], onDelete: Restrict)
  services             QuoteService[]
  paymentOptions       QuotePaymentOption[]

  @@index([establishmentId])
  @@index([establishmentId, createdAt])
  @@index([establishmentId, customerId])
  @@index([establishmentId, vehicleId])
  @@index([establishmentId, expiresAt])
  @@index([establishmentId, convertedAppointmentId])
  @@map("quotes")
}

model QuoteService {
  id                       String  @id @default(uuid()) @db.Uuid
  quoteId                  String  @map("quote_id") @db.Uuid
  serviceId                String  @map("service_id") @db.Uuid
  serviceName              String  @map("service_name") @db.VarChar(72)
  serviceCategoryId        String? @map("service_category_id") @db.Uuid
  serviceCategoryName      String? @map("service_category_name") @db.VarChar(48)
  serviceDurationInMinutes Int?    @map("service_duration_in_minutes")
  servicePriceInCents      Int     @map("service_price_in_cents")
  isCourtesy               Boolean @default(false) @map("is_courtesy")
  position                 Int     @default(0)

  quote   Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([quoteId, serviceId])
  @@index([quoteId])
  @@index([serviceId])
  @@map("quote_services")
}

model QuotePaymentOption {
  id            String             @id @default(uuid()) @db.Uuid
  quoteId       String             @map("quote_id") @db.Uuid
  method        QuotePaymentMethod
  label         String
  installments  Int?
  interestFree  Boolean            @default(true) @map("interest_free")
  discountType  QuoteDiscountType? @map("discount_type")
  discountValue Int?               @map("discount_value")
  totalInCents  Int                @map("total_in_cents")
  position      Int                @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId])
  @@map("quote_payment_options")
}
