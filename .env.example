# Environment
PORT=8080
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=clean_move
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clean_move

# Google OAuth
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Auth
REFRESH_TOKEN_TTL_IN_MS=1296000000
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
JWT_ACCESS_EXPIRES_IN=15m


# Auth — password flows
# Tempo em milissegundos: minutos × 60 × 1000 (ex.: 5 min = 300000, 15 min = 900000, 1 h = 3600000)

# Quanto tempo o código de 6 dígitos (alteração de senha logado) permanece válido.
# Usado ao solicitar POST /user/me/password/confirmation-code e no texto do e-mail.
PASSWORD_CHANGE_CONFIRMATION_CODE_TTL_IN_MS=300000

# Quanto tempo o link/token de redefinição de senha (esqueci minha senha) permanece válido.
# Usado ao solicitar POST /auth/password-reset/request e no texto do e-mail.
PASSWORD_RESET_TOKEN_TTL_IN_MS=900000

# Quantas vezes o usuário pode errar o código de confirmação antes dele ser invalidado.
# Após atingir o limite, é preciso solicitar um novo código.
PASSWORD_CONFIRMATION_CODE_MAX_FAILED_ATTEMPTS=5

# Rate limit — solicitar código ou link (POST .../confirmation-code e POST .../password-reset/request).
# AUTH_PASSWORD_FLOW_REQUEST_LIMIT = máximo de requisições por janela; AUTH_PASSWORD_FLOW_REQUEST_TTL_IN_MS = duração da janela.
AUTH_PASSWORD_FLOW_REQUEST_LIMIT=5
AUTH_PASSWORD_FLOW_REQUEST_TTL_IN_MS=3600000

# Rate limit — confirmar nova senha (POST /user/me/password e POST /auth/password-reset/confirm).
# AUTH_PASSWORD_FLOW_CONFIRM_LIMIT = máximo de tentativas por janela; AUTH_PASSWORD_FLOW_CONFIRM_TTL_IN_MS = duração da janela.
AUTH_PASSWORD_FLOW_CONFIRM_LIMIT=10
AUTH_PASSWORD_FLOW_CONFIRM_TTL_IN_MS=900000

# Resend
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=noreply@example.com
EMAIL_LOGO_URL=https://media.example.com/brand/logo.png
PASSWORD_RESET_PATH=http://localhost:3000/reset-password

# Cloudflare R2
AWS_REGION=auto
AWS_S3_BUCKET=replace-with-r2-bucket-name
AWS_S3_ENDPOINT=https://replace-with-account-id.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=replace-with-r2-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
AWS_S3_PUBLIC_BASE_URL=https://media.example.com
CORS_ALLOWED_ORIGINS=http://localhost:3000